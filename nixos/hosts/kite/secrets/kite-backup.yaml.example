# Copy this to kite-backup.yaml and encrypt it with sops before enabling
# alcachofa.kite.backups.  Do not commit the decrypted file.
#
# restic_* and b2_* are the existing values from Fourth's docker/.env.
restic_repository: b2:REPLACE_WITH_EXISTING_REPOSITORY:/restic
restic_password: REPLACE_WITH_EXISTING_RESTIC_PASSWORD
b2_account_id: REPLACE_WITH_EXISTING_B2_ACCOUNT_ID
b2_account_key: REPLACE_WITH_EXISTING_B2_ACCOUNT_KEY
