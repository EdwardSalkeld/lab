    {
      "id": 21,
      "title": "Selected-range gas (estimated)",
      "type": "stat",
      "description": "Sum of stored readings in the exact selected range, with end time excluded. Check the missing-reading panel. Gas is stored as m³ and converted using m³ × 1.02264 × calorific value ÷ 3.6. The default 40 MJ/m³ is an estimate, not a verified supplier value. The app/bill may differ. No standing charge is included in cost estimates.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "scheduler-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT SUM(consumption * 1.02264 * 40.0 / 3.6) AS value FROM usages\nWHERE interval_start >= $__timeFrom()::timestamptz\n    AND interval_start < $__timeTo()::timestamptz\n    AND usage_type = 'gas'"
        }
      ]
    },
