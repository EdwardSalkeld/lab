    {
      "id": 23,
      "title": "Missing half-hours",
      "type": "stat",
      "description": "Expected UTC half-hour slots in the selected range without a stored reading, separately for each fuel. London clock changes are included. Totals exclude these missing values; zero consumption is not a missing reading.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "scheduler-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH expected AS (\n  SELECT slot\n  FROM generate_series(\n    to_timestamp(ceil(extract(epoch FROM $__timeFrom()::timestamptz) / 1800) * 1800),\n    $__timeTo()::timestamptz, interval '30 minutes'\n  ) AS slot\n  WHERE slot < $__timeTo()::timestamptz\n)\nSELECT\n  COUNT(*) FILTER (WHERE e.interval_start IS NULL) AS electricity,\n  COUNT(*) FILTER (WHERE g.interval_start IS NULL) AS gas\nFROM expected\nLEFT JOIN usages e ON e.interval_start = expected.slot AND e.usage_type = 'electricity'\nLEFT JOIN usages g ON g.interval_start = expected.slot AND g.usage_type = 'gas'"
        }
      ]
    },
