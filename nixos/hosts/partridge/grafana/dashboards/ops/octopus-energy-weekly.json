          "rawSql": "WITH daily AS (\n  SELECT\n    DATE_TRUNC('day', interval_start AT TIME ZONE 'Europe/London') AS day_local,\n    SUM(consumption * 1.02264 * 40.0 / 3.6) AS day_kwh,\n    COUNT(*) AS reading_count\n  FROM usages\n  WHERE interval_start >= $__timeFrom()::timestamptz\n    AND interval_start < $__timeTo()::timestamptz\n    AND usage_type = 'gas'\n  GROUP BY 1\n), complete_days AS (\n  SELECT day_local, day_kwh\n  FROM daily\n  WHERE reading_count >= 46\n), weekly AS (\n  SELECT\n    DATE_TRUNC('week', day_local) AT TIME ZONE 'Europe/London' AS time,\n    SUM(day_kwh) * 0.07 AS weekly_cost_gbp,\n    COUNT(*) AS complete_day_count\n  FROM complete_days\n  GROUP BY 1\n), full_weeks AS (\n  SELECT time, weekly_cost_gbp\n  FROM weekly\n  WHERE complete_day_count = 7\n)\nSELECT\n  time,\n  weekly_cost_gbp,\n  AVG(weekly_cost_gbp) OVER (\n    ORDER BY time\n    ROWS BETWEEN 3 PRECEDING AND CURRENT ROW\n  ) AS rolling_4w_avg_cost_gbp\nFROM full_weeks\nORDER BY time",
          "refId": "A",
