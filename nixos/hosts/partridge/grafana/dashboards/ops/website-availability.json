      "description": "Successful HTTP(S) probes are 1; failed probes are 0. The probes also validate DNS, TLS, redirects and a successful HTTP response.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
